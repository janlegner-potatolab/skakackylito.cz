---
---

<dialog id="lightbox" class="lightbox" aria-label="Galerie fotek">
  <img id="lightbox-img" class="lightbox__img" alt="" />

  <button
    type="button"
    class="lightbox__btn lightbox__btn--close"
    aria-label="Zavřít"
    data-lightbox-close
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="18" y1="6" x2="6" y2="18" />
      <line x1="6" y1="6" x2="18" y2="18" />
    </svg>
  </button>

  <button
    type="button"
    class="lightbox__btn lightbox__btn--prev"
    aria-label="Předchozí fotka"
    data-lightbox-prev
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="15 18 9 12 15 6" />
    </svg>
  </button>

  <button
    type="button"
    class="lightbox__btn lightbox__btn--next"
    aria-label="Další fotka"
    data-lightbox-next
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="9 18 15 12 9 6" />
    </svg>
  </button>

  <div class="lightbox__counter" id="lightbox-counter" aria-live="polite"></div>
</dialog>

<style>
  .lightbox {
    border: none;
    padding: 0;
    margin: auto;
    background: transparent;
    max-width: 100vw;
    max-height: 100vh;
    overflow: visible;
  }
  .lightbox::backdrop {
    background: rgba(15, 23, 42, 0.92);
    backdrop-filter: blur(4px);
  }
  .lightbox__img {
    display: block;
    max-width: 92vw;
    max-height: 86vh;
    width: auto;
    height: auto;
    border-radius: 1rem;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.5);
    background: #000;
  }
  .lightbox__btn {
    position: fixed;
    z-index: 10;
    color: white;
    background: rgba(255, 255, 255, 0.12);
    border: none;
    border-radius: 9999px;
    width: 48px;
    height: 48px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(8px);
    transition: background 150ms ease, transform 150ms ease;
  }
  .lightbox__btn:hover {
    background: rgba(255, 255, 255, 0.28);
    transform: scale(1.05);
  }
  .lightbox__btn:focus-visible {
    outline: 2px solid #ff6b35;
    outline-offset: 2px;
  }
  .lightbox__btn--close { top: 1rem;    right: 1rem; }
  .lightbox__btn--prev  { top: 50%;     left: 1rem;  transform: translateY(-50%); }
  .lightbox__btn--next  { top: 50%;     right: 1rem; transform: translateY(-50%); }
  .lightbox__btn--prev:hover { transform: translateY(-50%) scale(1.05); }
  .lightbox__btn--next:hover { transform: translateY(-50%) scale(1.05); }

  .lightbox--single .lightbox__btn--prev,
  .lightbox--single .lightbox__btn--next,
  .lightbox--single .lightbox__counter {
    display: none;
  }

  .lightbox__counter {
    position: fixed;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    color: white;
    font-family: var(--font-body, system-ui);
    font-size: 0.875rem;
    padding: 0.375rem 0.875rem;
    background: rgba(0, 0, 0, 0.65);
    border-radius: 9999px;
    pointer-events: none;
  }

  /* prevent body scroll while open */
  :global(body:has(dialog#lightbox[open])) {
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .lightbox__btn { width: 42px; height: 42px; }
    .lightbox__btn--prev { left: 0.5rem; }
    .lightbox__btn--next { right: 0.5rem; }
    .lightbox__btn--close { top: 0.5rem; right: 0.5rem; }
  }
</style>

<script>
  type Trigger = HTMLElement;

  const dialog = document.getElementById("lightbox") as HTMLDialogElement | null;
  const img = document.getElementById("lightbox-img") as HTMLImageElement | null;
  const counter = document.getElementById("lightbox-counter") as HTMLElement | null;

  if (dialog && img && counter) {
    let gallery: { src: string; alt: string }[] = [];
    let index = 0;

    const show = (i: number) => {
      if (gallery.length === 0) return;
      index = (i + gallery.length) % gallery.length;
      const item = gallery[index];
      img.src = item.src;
      img.alt = item.alt;
      counter.textContent = `${index + 1} / ${gallery.length}`;
      dialog.classList.toggle("lightbox--single", gallery.length <= 1);
    };

    const open = (trigger: Trigger) => {
      const slug = trigger.dataset.gallery;
      if (!slug) return;
      const startIdx = parseInt(trigger.dataset.index || "0", 10);
      const all = Array.from(
        document.querySelectorAll<Trigger>(
          `[data-lightbox-trigger][data-gallery="${slug}"]`,
        ),
      );
      // Deduplicate by src (the main photo + its thumbnail share src), keep lowest data-index for each src
      const seen = new Set<string>();
      const unique: Trigger[] = [];
      all
        .sort((a, b) => parseInt(a.dataset.index || "0", 10) - parseInt(b.dataset.index || "0", 10))
        .forEach((t) => {
          const src = t.dataset.src || "";
          if (!seen.has(src)) {
            seen.add(src);
            unique.push(t);
          }
        });
      gallery = unique.map((t) => ({
        src: t.dataset.src || "",
        alt: t.dataset.alt || "",
      }));
      show(Math.min(startIdx, gallery.length - 1));
      if (!dialog.open) dialog.showModal();
    };

    document.addEventListener("click", (e) => {
      const target = (e.target as HTMLElement | null)?.closest<HTMLElement>(
        "[data-lightbox-trigger]",
      );
      if (target) {
        e.preventDefault();
        open(target);
      }
    });

    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });

    document.querySelector("[data-lightbox-close]")?.addEventListener("click", () => {
      dialog.close();
    });
    document.querySelector("[data-lightbox-prev]")?.addEventListener("click", (e) => {
      e.stopPropagation();
      show(index - 1);
    });
    document.querySelector("[data-lightbox-next]")?.addEventListener("click", (e) => {
      e.stopPropagation();
      show(index + 1);
    });

    document.addEventListener("keydown", (e) => {
      if (!dialog.open) return;
      if (e.key === "ArrowLeft") show(index - 1);
      else if (e.key === "ArrowRight") show(index + 1);
    });
  }
</script>
