---
const steps = [
  {
    icon: "📞",
    title: "Zavolejte nebo napište",
    description: "Domluvíme termín a vyberete atrakci.",
  },
  {
    icon: "🚚",
    title: "Přivezeme a postavíme",
    description: "Dovoz, stavba a kontrola bezpečnosti přímo na místě.",
  },
  {
    icon: "🎉",
    title: "Užívejte si",
    description: "Po akci vše odvezeme. Vy si jen užíváte.",
  },
];
---

<section id="jak-to-funguje" class="bg-white py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4">
    <header class="mx-auto mb-12 max-w-2xl text-center">
      <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-primary-600">
        Jak to funguje
      </p>
      <h2 class="font-display text-3xl font-bold text-ink-900 md:text-4xl">
        Jednoduše ve třech krocích
      </h2>
    </header>

    <ol class="grid gap-6 md:grid-cols-3">
      {steps.map((step, idx) => (
        <li class="rounded-card bg-cream p-6 text-center ring-1 ring-primary-100">
          <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-primary-500 text-2xl text-white shadow">
            {step.icon}
          </div>
          <div class="mb-2 text-xs font-semibold uppercase tracking-wide text-primary-600">
            Krok {idx + 1}
          </div>
          <h3 class="mb-2 font-display text-xl font-bold text-ink-900">{step.title}</h3>
          <p class="text-sm text-ink-700">{step.description}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
