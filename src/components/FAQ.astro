---
import { getCollection } from "astro:content";
import FAQItem from "./FAQItem.astro";

const items = (await getCollection("faq")).sort((a, b) => a.data.order - b.data.order);
---

<section id="faq" class="bg-cream py-16 md:py-24">
  <div class="mx-auto max-w-3xl px-4">
    <header class="mb-10 text-center">
      <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-primary-600">
        Časté dotazy
      </p>
      <h2 class="font-display text-3xl font-bold text-ink-900 md:text-4xl">
        Máte otázky? Máme odpovědi
      </h2>
    </header>

    <div class="flex flex-col gap-3">
      {items.map((item) => <FAQItem item={item} />)}
    </div>
  </div>
</section>
