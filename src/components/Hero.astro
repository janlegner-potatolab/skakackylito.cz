---
import { site } from "~/data/site";

const features = [
  "Dovoz až k vám",
  "Stavba a kotvení v ceně",
  "Pojištění odpovědnosti",
  `Norma ${site.certification}`,
];
---

<section id="top" class="relative overflow-hidden bg-cream">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 md:grid-cols-2 md:py-24 md:items-center">
    <div>
      <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-primary-600">
        Skákačky Lito · Litoměřice
      </p>
      <h1 class="font-display text-4xl font-bold leading-tight text-ink-900 md:text-5xl">
        {site.tagline}
      </h1>
      <p class="mt-4 max-w-prose text-lg text-ink-700">
        {site.description}
      </p>

      <ul class="mt-8 grid gap-4 sm:grid-cols-2">
        {features.map((label) => (
          <li class="flex items-center gap-3 text-lg font-semibold text-ink-900">
            <span
              aria-hidden="true"
              class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary-500 text-white shadow-sm"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="20 6 9 17 4 12" />
              </svg>
            </span>
            {label}
          </li>
        ))}
      </ul>

      <div class="mt-10 flex flex-wrap items-center gap-3">
        <a
          href="#atrakce"
          class="inline-flex items-center gap-2 rounded-full bg-primary-500 px-6 py-3 text-base font-semibold text-white shadow-sm hover:bg-primary-600 transition"
        >
          Prohlédnout atrakce
        </a>
      </div>
    </div>

    <div class="relative flex items-center justify-center aspect-square">
      <img
        src="/photos/logo_transparent.png"
        alt={`${site.name} — pronájem skákacích hradů Litoměřice`}
        width="1200"
        height="1200"
        class="max-h-full max-w-full object-contain"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </div>
</section>
